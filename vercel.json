{
  "version": 2,
  "builds": [
    {
      "src": "api/simulate.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["api/model_data.json"]
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/simulate",
      "dest": "/api/simulate.py"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
